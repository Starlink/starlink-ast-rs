 Begin PcdMap 	# Apply pincushion distortion
    Nin = 2 	# Number of input coordinates
 IsA Mapping 	# Mapping between coordinate systems
    PcdCn0 = 100 	# Distortion centre on first axis
    PcdCn1 = 100 	# Distortion centre on second axis
    Disco = 0.001 	# Distortion coefficient
 End PcdMap
